# ==============================================================================
# Título: Eliminar la última página de un archivo PDF (rmlp)
# Descripción: Función en Bash que utiliza 'qpdf' para generar un nuevo PDF
#              removiendo únicamente su última página.
# ==============================================================================

function rmlp {
    # Validar que se proporcione al menos el argumento del archivo de entrada
    if [ -z "$1" ]; then
        echo "Uso: rmlp <archivo.pdf> [archivo_salida.pdf]"
        return 1
    fi

    local input_file="$1"

    # Verificar la existencia del archivo especificado
    if [ ! -f "$input_file" ]; then
        echo "Error: El archivo '$input_file' no existe."
        return 1
    fi

    # Definir nombre de salida por defecto si no se pasa como segundo parámetro
    local output_file="${2:-${input_file%.pdf}_sin_ultima.pdf}"

    # Obtener el número total de páginas utilizando qpdf
    local total_pages
    total_pages=$(qpdf --show-npages "$input_file" 2>/dev/null)

    # Validar que se haya obtenido el conteo y que el archivo tenga más de 1 página
    if [ -z "$total_pages" ] || [ "$total_pages" -le 1 ]; then
        echo "Error: El PDF tiene 1 página o ninguna, no se puede eliminar la última."
        return 1
    fi

    # Calcular el rango de páginas a conservar (de la 1 a la penúltima)
    local last_page=$((total_pages - 1))

    # Extraer el rango seleccionado y guardar en el archivo de salida
    qpdf --empty --pages "$input_file" "1-$last_page" -- "$output_file"

    echo "¡Listo! Generado: $output_file (Páginas: 1-$last_page)"
}
