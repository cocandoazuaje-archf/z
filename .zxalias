#!/usr/bin/env zsh
# ============================================================
# ALIAS Y FUNCIONES VARIOS
# Autor: Carlos Eduardo Ocando Azuaje
# Descripción: Colección de alias y funciones para automatizar tareas
# ============================================================

# Colores
RED="\033[1;31m"
RESET="\033[0m"

# ============================================================
# SISTEMA Y TERMINAL
# ============================================================

alias un='unalias'
alias grep='grep --color=auto'
alias terminal='open -a kitty.app'
alias ter='open -na kitty'
alias x='source ~/.zshrc'
alias s='source'
alias ph='echo "$PATH"'
alias pw='pwd'
alias cl='clear'
alias ex='exit'
alias tm='tmux'
alias xoff='sudo shutdown -h now'

# ============================================================
# DESARROLLO (Angular, Maven, Spring, Node, Python, Dotnet, NPM)
# ============================================================

alias ngs='ng serve'
alias ngb='ng build'
alias mvncli='mvn clean install -X'
alias mvnclp='mvn clean package -X'
alias mvnsp='mvn spring-boot:run'
alias no='node'
alias n3v='node -v'
alias p3='python3'
alias pi3='pip3'
alias p3v='pip3 -V'
alias dt='dotnet'
alias np='npm'
alias ndm='nodemon'
alias m='mvn clean package -X | grep -iE "cause"'

# ============================================================
# GIT
# ============================================================

alias gits='git status'
alias gitr='git remote -v'
alias gitp='git push'
alias gitb='git branch'
alias gc='git clone'
alias gitl='git log -1 --oneline --graph --all --decorate'
alias gittar='git add ./todo_git.tar.gz && git commit -m "update tar" && git push'

# ============================================================
# DOCKER, VAGRANT, TERRAFORM
# ============================================================

alias dk='docker'
alias dksp='docker system prune -a'
alias vg='vagrant'
alias tf='terraform'

# ============================================================
# GLASSFISH
# ============================================================

alias glaso='asadmin start-domain && open http://localhost:4848/common/index.jsf'
alias glason='asadmin start-domain && open http://localhost:4848/common/applications/applications.jsf'
alias glasoff='asadmin stop-domain && open http://localhost:4848/common/index.jsf'
alias glasver='asadmin version'
alias glasres='asadmin restart-domain'
alias glasdomains='asadmin list-domains'
alias glasapps='asadmin list-applications'
alias gund='asadmin undeploy referidosrrvv'
alias gdep='asadmin deploy'
alias iraglas='open "http://localhost:4848/common/appServer/serverInstGeneralPe.jsf?instanceName=server"'
alias glaslog='tail -f /Users/carlosocando/Downloads/glassfish7/glassfish8/glassfish/domains/domain1/logs/server.log'

# Directorios Glassfish
alias glasconfig='code /Users/carlosocando/Downloads/glassfish7/glassfish8/glassfish/domains/domain1/config/domain.xml'
alias glasconfigcd='cd /Users/carlosocando/Downloads/glassfish7/glassfish8/glassfish/domains/domain1/config/'
alias glaslib='cd /Users/carlosocando/Downloads/glassfish7/glassfish8/glassfish/domains/domain1/lib'
alias glasbin='cd /Users/carlosocando/Downloads/glassfish7/glassfish8/glassfish/bin'

# ============================================================
# NAVEGACIÓN DE DIRECTORIOS
# ============================================================

alias u='cd "$HOME" && ls -lah && pwd'
alias r='cd / && ls -lah && pwd'
alias ..='cd .. && ls -lah && pwd'
alias ....='cd ../.. && ls -lah && pwd'
alias ......='cd ../../.. && ls -lah && pwd'
alias .-='cd - && ls -lah && pwd'

alias tmp='cd /tmp && ls -lah && pwd'
alias ssd='cd "/Volumes/tarjeta SD" && ls -lah && pwd'
alias pre='cd "$HOME/Documents/pre_" && ls -lah && pwd'
alias io='cd "$HOME/Documentos/ionix/Desarrollando" && ls -lah && pwd'
alias shell='cd /usr/local/shell2/shell2/linux/shell && ls -lah && pwd'
alias shell2ls='cd /Users/carlosocando/Documentos/ionix/Desarrollando/linux/shell && ls -lah && pwd'
alias eli='cd /Users/carlosocando/Documentos/referidos_elias && ls -lah && pwd'
alias jar='cd /Users/carlosocando/Desktop/jars'
alias cdjava='cd ~/Downloads/java'
alias cddow='cd ~/Downloads/'
alias ucd='cd /Users/carlosocando/Desktop'
alias cdd='cd ~/Desktop/'
alias cdm2='cd ~/.m2'

# ============================================================
# EDITORES Y APLICACIONES
# ============================================================

alias sub='subl'
alias subl='open -a "Sublime Text"'
alias code="open -a 'Visual Studio Code'"
alias cursor='open -a Cursor.app'
alias a='open -a Safari'
alias v='open -a vlc'
alias b='open -a "Brave Browser"'
alias typ='open -a "typora"'
alias keep='open https://keep.google.com/u/1/'
alias o='open'

# Accesos directos a archivos de config
alias xsubz='subl $HOME/.zshrc'
alias xsuba='subl $HOME/.zxalias'
alias xsubf='subl $HOME/.zxfunction'
alias xsubh='subl /etc/hosts'

alias xcodz='code $HOME/.zshrc'
alias xcoda='code $HOME/.zxalias'
alias xcodf='code $HOME/.zxfunction'
alias xcodh='code /etc/hosts'

alias xviz='vim $HOME/.zshrc'
alias xvia='vim $HOME/.zxalias'
alias xvif='vim $HOME/.zxfunction'
alias xvih='vim /etc/hosts'

alias xcod_x='code /Users/carlosocando/Documentos/ionix/Desarrollando/linux/shell/_xuplinuxshell.sh'
alias xviup='vim /Users/carlosocando/Documentos/ionix/Desarrollando/linux/shell/_xuplinuxshell.sh'

# Preferencias del sistema
alias teclado='open "x-apple.systempreferences:com.apple.Keyboard-Settings.extension"'
alias sustituto='open "x-apple.systempreferences:com.apple.Keyboard-Settings.extension"'
alias notifica='open "x-apple.systempreferences:com.apple.Notifications-Settings.extension"'
alias pass='open "x-apple.systempreferences:com.apple.Passwords-Settings.extension"'

# Web Apps
alias xiragit='open -a "Brave Browser" https://github.com'
alias xiradrive='open -a "Brave Browser" https://drive.google.com'

# ============================================================
# UTILIDADES Y SISTEMA
# ============================================================

alias visible='chflags nohidden'
alias pb='pbcopy'
alias xchis='history'
alias ll='ls -lah'
alias ld='ls -lah | grep "^d"'
alias htop_sys='htop'

# Formateadores
alias sintax='bash -n'
alias formathtml='prettier --write'
alias xformat='shfmt -w'
alias xformatall='find . -name "*.sh" -exec shfmt -w {} \;'
alias xformatsx='find . -type f -perm -111 -exec shfmt -w {} \;'

# Búsquedas / Grep
alias g='grep -i'
alias g1='grep -iE "cause"'
alias g4='grep -iE "cause|exception|failure|error|package"'

# Red y Fecha
alias ti='ping -c3 www.google.cl'
alias h12='date +"%I:%M:%S %p"'
alias ba='figlet'
alias xban='figlet'
alias d12='date "+%A, %d de %B de %Y a las %I:%M %p"'
alias gg='ffmpeg -f avfoundation -framerate 30 -i "0" salida.mp4'